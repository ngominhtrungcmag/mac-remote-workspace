"No trusted host keys yet" = "Chưa có khóa máy chủ đáng tin cậy";
"When you verify and connect to an SSH host, its public key will appear here for inspection and rotation." = "Sau khi xác minh và kết nối với máy chủ SSH, khóa công khai của máy chủ sẽ xuất hiện ở đây để kiểm tra và thay thế.";
"Development" = "Phát triển";
"Staging" = "Thử nghiệm";
"Production" = "Sản xuất";
"SSH password" = "Mật khẩu SSH";
"Key passphrase" = "Cụm mật khẩu khóa";
"Windows / RDP password" = "Mật khẩu Windows / RDP";
"%1$@ (%2$@) — %3$@" = "%1$@ (%2$@) — %3$@";
"Clipboard file transfer failed. Check file permissions and free disk space." = "Truyền tệp qua bảng nhớ tạm thất bại. Hãy kiểm tra quyền của tệp và dung lượng trống.";

"ProxyJump is not supported for SFTP." = "SFTP không hỗ trợ ProxyJump.";

"SFTP listing contains an invalid or unsupported filename." = "Danh sách SFTP chứa tên tệp không hợp lệ hoặc không được hỗ trợ.";
"Shared folder is not an accessible folder." = "Thư mục chia sẻ không tồn tại hoặc không truy cập được.";

"Enter a host address or connection URL." = "Nhập địa chỉ máy chủ hoặc URL kết nối.";
"The connection target is too long." = "Đích kết nối quá dài.";
"The connection target cannot contain control characters or whitespace." = "Đích kết nối không được chứa ký tự điều khiển hoặc khoảng trắng.";
"Choose SSH or RDP, or enter an ssh:// or rdp:// URL." = "Chọn SSH hoặc RDP, hoặc nhập URL ssh:// hay rdp://.";
"Only ssh:// and rdp:// URLs are supported." = "Chỉ hỗ trợ URL ssh:// và rdp://.";
"Do not include a password in the connection URL." = "Không đưa mật khẩu vào URL kết nối.";
"Connection URLs cannot include query parameters or fragments." = "URL kết nối không được chứa tham số truy vấn hoặc phần fragment.";
"Connection targets cannot include paths, commands, or options." = "Đích kết nối không được chứa đường dẫn, lệnh hoặc tùy chọn.";
"Enter a valid target such as ssh://user@host:22 or rdp://host:3389." = "Nhập đích hợp lệ, chẳng hạn ssh://user@host:22 hoặc rdp://host:3389.";
"Enter a valid SSH username without leading '-' or special characters." = "Nhập tên người dùng SSH hợp lệ, không bắt đầu bằng '-' hoặc chứa ký tự đặc biệt.";
"Do not include a username in an rdp:// URL; enter credentials in the RDP connection step." = "Không đưa tên người dùng vào URL rdp://; hãy nhập thông tin xác thực ở bước kết nối RDP.";
"Enter a valid DNS hostname, IPv4 address, or bracketed IPv6 address." = "Nhập tên máy chủ DNS, địa chỉ IPv4 hoặc địa chỉ IPv6 trong dấu ngoặc vuông hợp lệ.";
